# =============================================================================
# CAREPULSE ANALYTICS - ENVIRONMENT CONFIGURATION TEMPLATE
# Project 14: Hospital Bed Occupancy Forecasting with MCP Server & AI Agent
# =============================================================================

# Flask Backend API URL (used by MCP Server and frontend clients)
FLASK_API_URL=http://127.0.0.1:5000
PORT=5000

# OpenAI API Configuration
# Provide your OpenAI API key below to enable conversational reasoning
# with strict tool-calling against your trained ML model (best_model.pkl).
# If left blank, CarePulse will seamlessly run using the verified local engine.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Model Context Protocol (MCP) Server Settings
MCP_SERVER_NAME=carepulse-mcp-server
MCP_SERVER_VERSION=1.0.0
